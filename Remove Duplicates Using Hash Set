
#include <stdio.h>

int main() {
    int arr[] = {1, 2, 2, 3, 4, 3, 5};
    int n = 7;

    int unique[7];
    int count = 0;

    for (int i = 0; i < n; i++) {
        int found = 0;

        for (int j = 0; j < count; j++) {
            if (arr[i] == unique[j]) {
                found = 1;
                break;
            }
        }

        if (found == 0) {
            unique[count] = arr[i];
            count++;
        }
    }

    printf("After removing duplicates: ");

    for (int i = 0; i < count; i++) {
        printf("%d ", unique[i]);
    }

    return 0;
}
