
#include <stdio.h>

int main() {
    int arr[] = {90, 80, 70, 60, 50, 40, 30};
    int n = 7;
    int target = 50;

    int low = 0;
    int high = n - 1;
    int result = -1;

    while (low <= high) {
        int mid = low + (high - low) / 2;

        if (arr[mid] == target) {
            result = mid;
            break;
        }
        else if (arr[mid] < target) {
            high = mid - 1;
        }
        else {
            low = mid + 1;
        }
    }

    printf("Index = %d", result);

    return 0;
}
